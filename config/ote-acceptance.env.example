# =============================================================================
# Isolated NameSilo-OTE + Stripe-test-mode contract acceptance harness
# (Stage 12A) — NON-PRODUCTION ONLY.
#
# VARIABLE NAMES ONLY. No credentials, no guessed values — fill these in a
# SEPARATE non-production env file that is loaded ONLY by the isolated harness.
#
# NEVER place any of these in the production All Elite Cloud .env, and never
# commit real values. The preflight fails closed unless every value below is a
# genuine test/sandbox value (a sk_live_ key, the live NameSilo host, a
# production database/schema, a production port, or full mutations are refused).
# =============================================================================

# Explicit human acknowledgment that this is the isolated acceptance runner.
RUN_DOMAIN_OTE_ACCEPTANCE=

# NameSilo OTE (sandbox) ONLY. The endpoint host must be the documented OTE host.
NAMESILO_OTE_ENDPOINT=
NAMESILO_OTE_API_KEY=

# Stripe TEST mode ONLY (a sk_live_ key is refused).
STRIPE_DOMAIN_TEST_SECRET_KEY=
STRIPE_DOMAIN_TEST_WEBHOOK_SECRET=

# Test-only contact-encryption keyring (base64 32-byte keys; NOT the prod keys).
DOMAIN_CONTACT_ENC_KEY_V1=
DOMAIN_CONTACT_ENC_ACTIVE_VERSION=
DOMAIN_BLIND_INDEX_KEY_V1=
DOMAIN_BLIND_INDEX_ACTIVE_VERSION=

# Disposable PostgreSQL target — a throwaway database + a non-`public` schema.
# The schema must NOT be `public`; the URL must NOT be the production database.
OTE_PG_URL=
OTE_PG_SCHEMA=
OTE_CONFIRM_DISPOSABLE=
# Optional: the production database name to positively refuse (defence in depth).
PRODUCTION_PG_DATABASE=

# Loopback-only harness bind + a NON-production port (never 3300/3200).
OTE_HARNESS_PORT=
OTE_BIND_HOST=127.0.0.1

# Mutations MUST start disabled. Enabling `full` is refused by the preflight.
DOMAIN_OPERATIONS_MODE=disabled
DOMAIN_PURCHASING_ENABLED=false
